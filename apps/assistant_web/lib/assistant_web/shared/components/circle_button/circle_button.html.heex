<button
  type={@type}
  disabled={@disabled}
  class={[
    "inline-flex shrink-0 items-center justify-center overflow-hidden p-figma-sm",
    @variant in ["Send", "Close"] && "size-8 rounded-full bg-brand shadow-brand",
    @variant == "Switch-Context" && "size-8 rounded-bttn-lg bg-brand shadow-brand",
    @variant == "Burger" && "size-8 rounded-bttn-lg bg-brand shadow-burger",
    @variant == "Add" && "size-11 rounded-bttn-lg bg-primary shadow-add"
  ]}
  {@rest}
>
  <Icon.icon variant={@variant} />
</button>
