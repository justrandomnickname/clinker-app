<button
  type={@type}
  disabled={@disabled}
  class={[
    "inline-flex items-center justify-center overflow-hidden whitespace-nowrap rounded-bttn-sm px-figma-xxl py-figma-sm font-sans text-figma-md tracking-bttn",
    @variant == "primary" && "bg-brand text-secondary shadow-brand"
  ]}
  {@rest}
>
  {render_slot(@inner_block)}
</button>
