<div class="flex h-screen bg-primary">
  <ChatList.chat_list chats={@chats} />
  <main class="flex min-w-0 flex-1 items-center justify-center bg-white">
    <div class="flex h-full w-chat flex-col gap-chat bg-primary">
      <ChatWindow.chat_window messages={@messages} />
      <ChatInput.chat_input draft={@draft} phase={@phase} meter={@meter} />
    </div>
  </main>
</div>
