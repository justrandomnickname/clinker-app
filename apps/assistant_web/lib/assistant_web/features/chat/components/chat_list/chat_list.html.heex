<aside class="flex h-full w-menu shrink-0 flex-col gap-figma-md bg-brand">
  <div class="flex w-full flex-col items-center bg-white px-figma-lg py-figma-xl">
    <Button.button id="new-chat" type="button" phx-click="new_chat">
      Новый чат
    </Button.button>
  </div>
  <div class="flex min-h-0 flex-1 flex-col gap-figma-md overflow-y-auto">
    <.async_result :let={chats} assign={@chats}>
      <:failed>Не удалось прочитать чаты</:failed>
      <div :for={chat <- chats} class="flex items-center justify-between px-figma-lg">
        <button
          type="button"
          id={"chat-#{chat.id}"}
          phx-click="select_chat"
          phx-value-id={chat.id}
          class="min-w-0 flex-1 truncate text-left font-sans text-figma-md text-secondary"
        >
          {chat.title}
        </button>
        <button
          type="button"
          id={"delete-chat-#{chat.id}"}
          phx-click="delete_chat"
          phx-value-id={chat.id}
          data-confirm="Удалить чат?"
          aria-label="Удалить чат"
          class="shrink-0"
        >
          <img src="/icons/close-circle.svg" width="16" height="16" alt="" />
        </button>
      </div>
    </.async_result>
  </div>
</aside>
