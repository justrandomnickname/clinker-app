<div id="log" class="flex-1">
  <.async_result :let={messages} assign={@messages}>
    <:failed>Не удалось прочитать сообщения</:failed>
    <article
      :for={message <- messages}
      id={"message-#{message.id}"}
      class={[
        "wrap-anywhere border-b border-line py-[0.7rem]",
        message.role == "user" && "whitespace-pre-wrap text-user",
        message.role != "user" && "markdown"
      ]}
    >
      {if message.role == "user" do
        message.content
      else
        Markdown.render(message.content)
      end}
    </article>
  </.async_result>
</div>
