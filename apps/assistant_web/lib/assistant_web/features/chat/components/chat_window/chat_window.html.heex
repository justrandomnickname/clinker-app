<div id="log" class="flex min-h-0 w-full flex-1 flex-col gap-chat overflow-y-auto overscroll-y-contain px-safe-lg pt-figma-md pb-keyboard">
  <.async_result :let={messages} assign={@messages}>
    <:failed>Не удалось прочитать сообщения</:failed>
    <article
      :for={message <- messages}
      id={"message-#{message.id}"}
      class={[
        "text-figma-md text-secondary",
        message.role == "user" &&
          "w-full rounded-bttn-md bg-brand-light px-figma-md py-figma-lg text-right shadow-message"
      ]}
    >
      <div :if={message.role == "user"} class="whitespace-pre-wrap">{message.content}</div>
      <Markdown.markdown
        :if={message.role != "user"}
        source={message.content}
        class="chat-copy w-full"
      />
    </article>
  </.async_result>
</div>
