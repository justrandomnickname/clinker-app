<main class="flex min-h-screen items-center justify-center px-4">
  <form
    id="context"
    class="flex w-full max-w-sm flex-col gap-2"
    phx-change="draft"
    phx-submit="enter"
  >
    <input
      type="text"
      name="text"
      value={@draft}
      placeholder="Введите контекст"
      autocomplete="off"
      autofocus
      class="rounded-md border border-[#ccc] bg-white px-[0.7rem] py-[0.55rem] font-[inherit]"
    /> <button type="submit" class="px-[0.9rem] py-[0.55rem] font-[inherit]">Открыть</button>
    <p class="min-h-5 text-reason">{@reason}</p>
  </form>
</main>
